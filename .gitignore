# Firebase / Google service account keys. These carry a private key and belong
# only in EAS, never in the repository. Note that google-services.json is NOT
# one of these: it holds identifiers, not secrets, and has to be committed for
# the Android build to find it.
*service-account*.json
*firebase-adminsdk*.json

# Prisma
packages/infrastructure/prisma/*.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

