auto-install-peers=true
strict-peer-dependencies=false
save-exact=true

# React Native's toolchain resolves Babel presets and plugins by name from the
# app directory, but pnpm's isolated store only puts a package's own declared
# dependencies there. Every plugin babel-preset-expo names as a string would
# otherwise fail to resolve, one at a time, and only in a clean install: a
# developer machine that has run `pnpm add` a few times keeps enough in the
# virtual store to hide it. Hoisting just the Babel packages to the root fixes
# the whole class without switching the workspace to the hoisted linker.
#
# The first two entries are pnpm's own defaults. Setting this key at all
# REPLACES the default list rather than adding to it, so leaving them out
# un-hoists eslint and prettier and breaks every package that resolves a shared
# eslint config.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@babel/*
public-hoist-pattern[]=babel-plugin-*
public-hoist-pattern[]=babel-preset-*
