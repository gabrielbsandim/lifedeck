{
  "name": "@lifedeck/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eas-build-post-install": "cd ../.. && pnpm exec turbo run build --filter=@lifedeck/mobile^...",
    "store:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/store/store-assets.ts",
    "release:version": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/release/release-version.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.19",
    "@lifedeck/application": "workspace:*",
    "@lifedeck/client": "workspace:*",
    "@lifedeck/domain": "workspace:*",
    "@lifedeck/i18n": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "5.62.11",
    "expo": "~57.0.34",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.22",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.25",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.22",
    "expo-linking": "~57.0.14",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.26",
    "expo-router": "~57.0.32",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.29",
    "expo-web-browser": "~57.0.3",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@lifedeck/config": "workspace:*",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "2.1.8",
    "babel-preset-expo": "~57.0.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
