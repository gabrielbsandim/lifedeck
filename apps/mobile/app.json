{
  "expo": {
    "name": "Lifedeck",
    "slug": "lifedeck",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "lifedeck",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifedeck.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lifedeck uses the microphone so you can send the assistant a voice note.",
        "NSPhotoLibraryUsageDescription": "Lifedeck uses your photos so you can send the assistant a picture and set a profile photo."
      }
    },
    "android": {
      "package": "com.lifedeck.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-audio",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
