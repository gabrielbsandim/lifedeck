{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.lifedeck.com.br"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.lifedeck.com.br"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "e2e-test": {
      "withoutCredentials": true,
      "distribution": "internal",
      "channel": "e2e",
      "environment": "preview",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.1"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.lifedeck.com.br"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.lifedeck.com.br"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6838782178",
        "appleTeamId": "7NDK3458CP",
        "metadataPath": "./store.config.js"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
